# Copy this file to .env and fill in your own local values.
# Never commit a real .env file with real secrets.

# Flask
# Production: set FLASK_SECRET_KEY to a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-dev-secret-key
FLASK_DEBUG=True            # set to False anywhere except local dev

# Database
# Default: local SQLite file, zero configuration, works instantly.
DATABASE_URL=sqlite:///certitrust.db

# To use MySQL via XAMPP instead, comment the line above and uncomment below,
# after creating the "certitrust" database in phpMyAdmin and importing
# database/schema.sql.
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/certitrust

# To use PostgreSQL (recommended for cloud deploys such as Render), install the
# driver first: pip install "psycopg[binary]"
# Render injects this automatically when the render.yaml blueprint is applied.
# DATABASE_URL=postgresql+psycopg://user:password@host:port/certitrust

# QR / verification
# Base URL embedded inside every generated QR code.
# Local:   http://localhost:5000/verify
# Render:  https://certitrust.onrender.com/verify  (use your real URL in production)
BASE_VERIFY_URL=http://localhost:5000/verify

# Demo account password (for local demo only, never use in production)
DEMO_PASSWORD=Demo@1234
